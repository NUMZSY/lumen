# Use exact HTTPS origins in production; localhost HTTP is only for local development.
PUBLIC_URL=https://proxy.your-domain.example
LUMEN_ORIGIN=https://lumen.your-domain.example

# Replace both placeholders with separate locally generated random values.
# Suggested: openssl rand -hex 16 (access code), openssl rand -hex 32 (token secret).
PROXY_ACCESS_PASSWORD=replace-with-a-random-access-code-of-at-least-24-characters
PROXY_TOKEN_SECRET=replace-with-a-different-random-signing-secret-of-at-least-32-characters

# The host may inject PORT automatically. TRUST_PROXY is optional; see README.
PORT=8080
TRUST_PROXY=0
